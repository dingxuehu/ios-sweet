+/*
+ * whyred 0114: a band whose colour comes from a register, at an x offset.  The
+ * original SWEET_BAND_V always starts at panel x = 0, which is why 0113 had to
+ * find a free row for every single check; this one can put several checks in
+ * one row.  Everything else is identical, including the register discipline:
+ * only x6..x11 are touched, and the caller's colour register is copied to x7
+ * before x10 is reused as the inner counter.  It has to be defined before the
+ * checks below use it -- .macro is expanded where it is written, not where it
+ * ends up in the file.
+ */
+.macro SWEET_BAND_X row, xoff, colreg
+	MOV64	x6, (0x9d400000 + (\row) * 4320 + (\xoff) * 4)
+	mov		x7, \colreg
+	mov		x8, #32
+	mov		x9, #4320
+1:	mov		x10, #64
+	mov		x11, x6
+2:	str		w7, [x11], #4
+	subs	x10, x10, #1
+	b.ne	2b
+	add		x6, x6, x9
+	subs	x8, x8, #1
+	b.ne	1b
+	dsb		sy
+.endm
+#endif
